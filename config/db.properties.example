# Copy to db.properties and edit host/user/pass.
driverClassName = com.mysql.cj.jdbc.Driver

# MySQL 5.7 + 8.x (requires lib/mysql-connector-j-8.0.33.jar on classpath)
url = jdbc:mysql://127.0.0.1:3306/maple?autoReconnect=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

username = maple
password = maple
timeout = 300000

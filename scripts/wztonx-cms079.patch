+// VariantNone 表示 WZ 里的字符串没有 AES 加密（老 GMS，或被私服重打包过的 WZ）
+const VariantNone = byte(255)
+
+// ActiveIVVariant 决定 NewFile 用哪个 AES IV，由命令行 -iv 设置。
+// 默认 SEA：CMS079 (ZMS) 实测用的就是 SEA/KMS 的 IV B9 7D 63 E9。
+var ActiveIVVariant = VariantSEA
+
+// NewEncryptionForVariant 在 VariantNone 时返回 nil，表示不做 AES 解密
+func NewEncryptionForVariant(variant byte) *Encryption {
+	if variant == VariantNone {
+		return nil
+	}
+	return NewEncryption(variant)
+}
